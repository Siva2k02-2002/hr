#--------------------------------------------------------------------
# SUPER ADMIN — PRODUCTION .env TEMPLATE
#
# Copy to `.env`, fill in every blank. Never commit a filled-in .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://superadmin.REPLACE-WITH-YOUR-DOMAIN.com/'
app.baseDomain = 'REPLACE-WITH-YOUR-DOMAIN.com'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# EMAIL / SMTP — subscription renewal reminders (subscriptions:expiry-sync).
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = REPLACE-WITH-SMTP-HOST
email.SMTPUser = REPLACE-WITH-SMTP-USER
email.SMTPPass = REPLACE-WITH-SMTP-PASSWORD
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = no-reply@REPLACE-WITH-YOUR-DOMAIN.com
email.fromName = REPLACE-WITH-YOUR-COMPANY-NAME

#--------------------------------------------------------------------
# DATABASE — this app's own platform DB. The connecting user needs full
# read/write (it provisions tenant databases), unlike HRMS's read-only
# platform_reader account.
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = hrms_platform
database.default.username = REPLACE-WITH-DB-USER
database.default.password = REPLACE-WITH-DB-PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION — MUST match HRMS's encryption.key byte-for-byte.
# Generate once with: php spark key:generate --show
#--------------------------------------------------------------------

encryption.key = REPLACE-WITH-GENERATED-KEY-MATCHING-HRMS

#--------------------------------------------------------------------
# LICENSE SIGNING SECRET — MUST match HRMS's license.signingSecret.
#--------------------------------------------------------------------

license.signingSecret = REPLACE-WITH-LONG-RANDOM-STRING-MATCHING-HRMS
