#--------------------------------------------------------------------
# HRMS — PRODUCTION .env TEMPLATE
#
# Copy to `.env`, fill in every blank, then review the whole file —
# nothing here should be left as a placeholder value at go-live.
# Never commit a filled-in .env to version control.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://REPLACE-WITH-WILDCARD-OR-PER-TENANT-DOMAIN/'
app.baseDomain = 'REPLACE-WITH-YOUR-DOMAIN.com'

# Requires a valid TLS certificate already terminating in front of this app
# (see the Apache/Nginx configs in DEPLOYMENT_GUIDE.md). Cookies become
# Secure-flagged automatically the moment this is true — no separate setting.
app.forceGlobalSecureRequests = true

# Leave off unless actively performing maintenance.
# app.maintenanceMode = true
app.maintenanceBypassToken = REPLACE-WITH-A-LONG-RANDOM-STRING

#--------------------------------------------------------------------
# EMAIL / SMTP — required for password reset, email verification,
# notifications, and the payslip-available email to actually deliver.
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = REPLACE-WITH-SMTP-HOST
email.SMTPUser = REPLACE-WITH-SMTP-USER
email.SMTPPass = REPLACE-WITH-SMTP-PASSWORD
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = no-reply@REPLACE-WITH-YOUR-DOMAIN.com
email.fromName = REPLACE-WITH-YOUR-COMPANY-NAME

#--------------------------------------------------------------------
# DATABASE
#
# database.default is a scratch connection used only for authoring/testing
# migrations locally — it is NEVER used to serve a real tenant request.
# In production it can point at any reachable, low-privilege placeholder;
# every real tenant request resolves its own database dynamically.
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = hrms_template
database.default.username = REPLACE-WITH-DB-USER
database.default.password = REPLACE-WITH-DB-PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Read-only connection to the master (platform registry) database (Super Admin's DB). The MySQL
# user here MUST be a dedicated, SELECT-only account — never point this at a
# writable/root credential.
database.master.hostname = 127.0.0.1
database.master.database = hrms_platform
database.master.username = platform_reader
database.master.password = REPLACE-WITH-READONLY-DB-PASSWORD
database.master.DBDriver = MySQLi
database.master.DBPrefix =
database.master.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#
# MUST be byte-for-byte identical to Super Admin's encryption.key — tenant
# DB passwords are encrypted by Super Admin and only ever decrypted here.
# Generate once with: php spark key:generate --show
#--------------------------------------------------------------------

encryption.key = REPLACE-WITH-GENERATED-KEY-MATCHING-SUPERADMIN

#--------------------------------------------------------------------
# LICENSE SIGNING SECRET
#
# Must match Super Admin's license.signingSecret exactly. Generate with:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#--------------------------------------------------------------------

license.signingSecret = REPLACE-WITH-LONG-RANDOM-STRING-MATCHING-SUPERADMIN
license.offlineCacheHours = 72
